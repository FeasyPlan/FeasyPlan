{
  "buildCommand": "node build.js",
  "outputDirectory": "dist",
  "routes": [
    {
      "src": "/terminos",
      "dest": "/terminos.html"
    },
    {
      "src": "/privacidad",
      "dest": "/privacidad.html"
    },
    {
      "src": "/cookies",
      "dest": "/cookies.html"
    },
    {
      "src": "/ejercicios",
      "dest": "/ejercicios.html"
    },
    {
      "src": "/ejercicios/([a-z0-9-]+)",
      "dest": "/ejercicios/$1.html"
    },
    {
      "src": "/ejercicio/([a-z0-9-]+)",
      "dest": "/ejercicio/$1.html"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/(.*)",
      "dest": "/404.html",
      "status": 404
    }
  ]
}
